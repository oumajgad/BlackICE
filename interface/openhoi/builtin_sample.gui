			buttonFont = "Arial12_bold_black"
		}
		guiButtonType = {
			name = "green_button"
			position = { x = 144 y = 118 }
			built_in = { style = button size = { x = 120 y = 26 } color = { r = 96 g = 150 b = 80 } }
			buttonText = "coloured"
			buttonFont = "Arial12_bold_black"
		}
		guiButtonType = {
			name = "red_button"
			position = { x = 276 y = 118 }
			built_in = { style = button size = { x = 120 y = 26 } color = { r = 170 g = 70 b = 60 } }
			buttonText = "coloured"
			buttonFont = "Arial12_bold_black"
		}

		iconType = {
			name = "flat_green"
			position = { x = 12 y = 160 }
			built_in = { style = flat size = { x = 60 y = 60 } color = { r = 0 g = 255 b = 0 } }
		}
		iconType = {
			name = "flat_blue"
			position = { x = 84 y = 160 }
			built_in = { style = flat size = { x = 60 y = 60 } color = { r = 40 g = 90 b = 200 } }
		}
		iconType = {
			name = "flat_clear"
			position = { x = 156 y = 160 }
			built_in = { style = flat size = { x = 60 y = 60 } color = { r = 200 g = 40 b = 40 a = 110 } }
		}
		iconType = {
			name = "frame"
			position = { x = 228 y = 160 }
			built_in = { style = frame size = { x = 180 y = 60 } }
		}
