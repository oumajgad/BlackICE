			font = "Arial12_headline"
			borderSize = {x = 0 y = 0}
			maxWidth = 172
			maxHeight = 18
			text = ""
			orientation = "UPPER_LEFT"
			format = centre
		}
		guiButtonType = {
			name = "decrease_openhoi_premonth_button"
			position = { x = 30 y = 106 }
			quadTextureSprite ="option_prev"
			tooltip = ""
			tooltipText =""
			delayedTooltipText = ""
		}
		guiButtonType = {
			name = "increase_openhoi_premonth_button"
			position = { x = 165 y = 106 }
			quadTextureSprite ="option_next"
