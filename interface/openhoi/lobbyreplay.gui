# The lobby's replay buttons on OpenHOI3, under the window of rules, in a game of one: Watch replay, Export replay and
# Import replay. Watch and Export are greyed until a saved game that was recorded is loaded; Import until a replay
# file waits in the saves' import folder. Read by OpenHOI3 alone - the original does not open this folder. Every
# picture is a built-in element. The buttons' texts are OPENHOI_WATCH_REPLAY, OPENHOI_EXPORT_REPLAY and
# OPENHOI_IMPORT_REPLAY, their tooltips the same keys with _TIP. See OpenHOI3's docs/replay.md, sections 11 and 17.
guiTypes = {
	windowType = {
		name = "openhoi_lobby_replay"
		backGround = "background"
		position = { x = -232 y = 696 }
		size = { x = 224 y = 94 }
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "UPPER_RIGHT"

		iconType = { name = "background" position = { x = 0 y = 0 } built_in = { style = panel size = { x = 224 y = 94 } } }
		guiButtonType = { name = "watch_replay" position = { x = 8 y = 6 } built_in = { style = button size = { x = 208 y = 26 } } buttonText = "OPENHOI_WATCH_REPLAY" buttonFont = "Arial12_bold_black" }
		guiButtonType = { name = "export_replay" position = { x = 8 y = 34 } built_in = { style = button size = { x = 208 y = 26 } } buttonText = "OPENHOI_EXPORT_REPLAY" buttonFont = "Arial12_bold_black" }
		guiButtonType = { name = "import_replay" position = { x = 8 y = 62 } built_in = { style = button size = { x = 208 y = 26 } } buttonText = "OPENHOI_IMPORT_REPLAY" buttonFont = "Arial12_bold_black" }
	}
}
