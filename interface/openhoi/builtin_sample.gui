# A sample of OpenHOI3's built-in elements: every style, with no texture and no sprite behind any of them.
# Read by OpenHOI3 alone - the original does not open this folder. Shown by the developer switch
# --window=openhoi_builtin_sample. See OpenHOI3's docs/mechanics/builtin.md.
guiTypes = {
	windowType = {
		name = "openhoi_builtin_sample"
		backGround = "bg"
		position = { x = 420 y = 140 }
		size = { x = 420 y = 330 }
		moveable = 1
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "UPPER_LEFT"

		iconType = {
			name = "bg"
			position = { x = 0 y = 0 }
			built_in = { style = panel size = { x = 420 y = 330 } }
		}
		iconType = {
			name = "title_bar"
			position = { x = 4 y = 4 }
			built_in = { style = header size = { x = 412 y = 24 } }
		}
		instantTextBoxType = {
			name = "title"
			position = { x = 4 y = 8 }
			font = "Arial12_bold"
			text = "Built-in elements"
			maxWidth = 412
			maxHeight = 20
			format = centre
		}

		iconType = {
			name = "row_one"
			position = { x = 12 y = 40 }
			built_in = { style = row size = { x = 396 y = 26 } }
		}
