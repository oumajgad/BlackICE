# The lobby's button that plays back the game a loaded save came of: OpenHOI3 puts this window up, under the window of
# rules, only while the save loaded names a recording that can be followed back to its start. Read by OpenHOI3 alone -
# the original does not open this folder. Every picture is a built-in element. The button's text is
# OPENHOI_WATCH_REPLAY and its tooltip OPENHOI_WATCH_REPLAY_TIP, or OPENHOI_WATCH_REPLAY_OTHER_ENGINE where the
# recording was made with another engine. See OpenHOI3's docs/replay.md, section 11.
guiTypes = {
	windowType = {
		name = "openhoi_lobby_replay"
		backGround = "background"
		position = { x = -232 y = 696 }
		size = { x = 224 y = 38 }
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "UPPER_RIGHT"

		iconType = { name = "background" position = { x = 0 y = 0 } built_in = { style = panel size = { x = 224 y = 38 } } }
		guiButtonType = { name = "watch_replay" position = { x = 8 y = 6 } built_in = { style = button size = { x = 208 y = 26 } } buttonText = "OPENHOI_WATCH_REPLAY" buttonFont = "Arial12_bold_black" }
	}
}
