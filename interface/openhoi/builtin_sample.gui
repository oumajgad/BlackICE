			name = "row_one_label"
			position = { x = 20 y = 46 }
			font = "Arial12_bold_black"
			text = "row"
			maxWidth = 200
			maxHeight = 20
		}
		iconType = {
			name = "row_two"
			position = { x = 12 y = 66 }
			built_in = { style = row size = { x = 396 y = 26 } }
		}
		instantTextBoxType = {
			name = "row_two_label"
			position = { x = 20 y = 72 }
			font = "Arial12_bold_black"
			text = "row, with a field"
			maxWidth = 200
			maxHeight = 20
		}
		iconType = {
			name = "field"
			position = { x = 300 y = 69 }
			built_in = { style = field size = { x = 100 y = 20 } }
		}

		iconType = {
			name = "divider"
			position = { x = 12 y = 104 }
			built_in = { style = divider size = { x = 396 y = 2 } }
		}

		guiButtonType = {
			name = "plain_button"
			position = { x = 12 y = 118 }
			built_in = { style = button size = { x = 120 y = 26 } }
