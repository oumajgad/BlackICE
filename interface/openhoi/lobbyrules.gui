# An enhanced game's own rules in the lobby, beside the original's options: OpenHOI3 puts this window up with its
# option window where the file declares it. Read by OpenHOI3 alone - the original does not open this folder. Every
# picture is a built-in element. See OpenHOI3's docs/mechanics/statisticsrecord.md, section 6.
guiTypes = {
	windowType = {
		name = "openhoi_lobby_rules"
		backGround = "background"
		position = { x = -232 y = 575 }
		size = { x = 224 y = 64 }
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "UPPER_RIGHT"

		iconType = { name = "background" position = { x = 0 y = 0 } built_in = { style = panel size = { x = 224 y = 64 } } }
		iconType = { name = "title_bar" position = { x = 4 y = 4 } built_in = { style = header size = { x = 216 y = 22 } } }
		instantTextBoxType = { name = "title" position = { x = 4 y = 7 } font = "Arial12_bold" text = "OPENHOI_RULES_TITLE" maxWidth = 216 maxHeight = 18 format = centre }

		# A tick with no picture of its own: a field that shows an X while it is on.
		guiButtonType = { name = "statistics" position = { x = 12 y = 34 } built_in = { style = field size = { x = 20 y = 20 } } buttonText = "" buttonFont = "Arial12_bold_black" }
		instantTextBoxType = { name = "statistics_label" position = { x = 40 y = 37 } font = "Arial12_bold_black" text = "OPENHOI_RULE_STATISTICS" maxWidth = 148 maxHeight = 18 }
		# What the rule keeps: its tooltip is the text of OPENHOI_RULE_STATISTICS_TIP.
		guiButtonType = { name = "statistics_help" position = { x = 194 y = 35 } built_in = { style = button size = { x = 18 y = 18 } } buttonText = "?" buttonFont = "Arial12_bold_black" }
	}
}
