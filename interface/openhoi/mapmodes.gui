# OpenHOI3's custom map modes: the list a right click on a map mode's button opens, and the legend of the source
# shown. Read by OpenHOI3 alone - the original does not open this folder. Every picture is a built-in element.
# See OpenHOI3's docs/mechanics/custommapmodes.md.
guiTypes = {
	windowType = {
		name = "openhoi_mapmode_list"
		backGround = "background"
		position = { x = 0 y = 0 }
		size = { x = 236 y = 316 }
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "UPPER_LEFT"

		iconType = {
